  dir: experiments/derisk-v1/runs/pad_batchmax
probe:
  output_dir: experiments/derisk-v1/runs/pad_batchmax
  pad_distance_edges:
  - 1
  - 8
  - 64
  - 512
  - 4096
  nsys_start_step: -1
  nsys_end_step: -1
  nsys_ranks:
  - 0
