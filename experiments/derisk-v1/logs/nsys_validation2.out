  - ep8
  dir: experiments/derisk-v1/runs/nsys_pad_fixed8192
probe:
  output_dir: experiments/derisk-v1/runs/nsys_pad_fixed8192
  pad_distance_edges:
  - 1
  - 8
  - 64
  - 512
  - 4096
  nsys_start_step: 2
  nsys_end_step: 3
  nsys_ranks:
  - 0
  - 1
nvtx: true
