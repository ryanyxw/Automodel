optimizer:
  _target_: transformer_engine.pytorch.optimizers.fused_adam.FusedAdam
  betas:
  - 0.9
  - 0.95
  eps: 1.0e-08
  lr: 1.0e-05
  weight_decay: 0
  master_weights: true
