  output_hidden_states: true
  backend:
    _target_: nemo_automodel.components.models.common.BackendConfig
    attn: te
    linear: te
    rms_norm: torch_fp32
    experts: torch_mm
    dispatcher: deepep
    fake_balanced_gate: false
    enable_hf_state_dict_adapter: true
checkpoint:
  enabled: false
  checkpoint_dir: experiments/main-v1.1/runs/batchmax_default/checkpoint
peft:
  _target_: nemo_automodel.components._peft.lora.PeftConfig
  exclude_modules:
  - '*.out_proj'
  - lm_head
  dim: 8
  alpha: 32
  use_triton: false
distributed:
  strategy: fsdp2
  tp_size: 1
  cp_size: 1
  pp_size: 1
  ep_size: 4
  sequence_parallel: false
  activation_checkpointing: true
loss_fn:
  _target_: nemo_automodel.components.loss.linear_ce.FusedLinearCrossEntropy
dataset:
  _target_: nemo_automodel.components.datasets.llm.chat_dataset.ChatDataset
  path_or_dataset_id: experiments/main-v1/data/train.jsonl
  chat_template: experiments/main-v1/templates/nano3_generation.jinja
  seq_length: 8192
  truncation: true
  padding: do_not_pad
packed_sequence:
  packed_sequence_size: 0
dataloader:
  _target_: torchdata.stateful_dataloader.StatefulDataLoader
  shuffle: false
  num_workers: 4
  collate_fn:
    _target_: nemo_automodel.components.datasets.utils.default_collater
optimizer:
  _target_: torch.optim.Adam
  betas:
  - 0.9
  - 0.999
  eps: 1.0e-08
  lr: 1.0e-05
  weight_decay: 0
lr_scheduler:
  lr_decay_style: cosine
  min_lr: 1.0e-06
mfu:
  peak_tflops: 989
wandb:
  project: main-v1.1
  group: batchmax
  name: batchmax_default
  tags:
  - nemotron-nano-3
  - ifchat
  - padding
  - mfu
  - ep4
  - lora
  dir: experiments/main-v1.1/runs/batchmax_default
probe:
  output_dir: experiments/main-v1.1/runs/batchmax_default
  pad_distance_edges:
  - 1
  - 8
  - 64
  - 512
  - 4096
  summary_warmup_steps: 2
  nsys_start_step: -1
  nsys_end_step: -1
  nsys_ranks:
  - 0
