  checkpoint_dir: experiments/main-v1.1/runs/smoke_batchmax_random/checkpoint
peft:
  _target_: nemo_automodel.components._peft.lora.PeftConfig
  exclude_modules:
  - '*.out_proj'
  - lm_head
  dim: 8
  alpha: 32
  use_triton: false
distributed:
