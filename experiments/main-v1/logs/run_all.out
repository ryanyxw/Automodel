    enable_hf_state_dict_adapter: true
checkpoint:
  enabled: false
  checkpoint_dir: experiments/main-v1/runs/fixed_default/checkpoint
distributed:
  strategy: fsdp2
  tp_size: 1
  cp_size: 1
  pp_size: 1
  ep_size: 8
  sequence_parallel: false
  activation_checkpointing: true
